{
  "name": "@faws/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fetchers": {
      "types": "./src/fetchers/index.ts",
      "default": "./src/fetchers/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "catalog:aws",
    "@aws-sdk/client-cloudwatch": "catalog:aws",
    "@aws-sdk/client-cloudwatch-logs": "catalog:aws",
    "@aws-sdk/client-ec2": "catalog:aws",
    "@aws-sdk/client-ec2-instance-connect": "catalog:aws",
    "@aws-sdk/client-ecs": "catalog:aws",
    "@aws-sdk/client-elastic-load-balancing-v2": "catalog:aws",
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/client-ssm": "catalog:aws",
    "@aws-sdk/client-sts": "catalog:aws",
    "@aws-sdk/credential-providers": "catalog:aws",
    "@faws/contracts": "workspace:*",
    "@faws/kit": "workspace:*",
    "@faws/shared": "workspace:*",
    "@smithy/shared-ini-file-loader": "catalog:aws",
    "ssh-config": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}

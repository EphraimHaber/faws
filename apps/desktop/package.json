{
  "name": "@faws/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsdown",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@faws/contracts": "workspace:*",
    "@faws/server": "workspace:*",
    "@trpc/client": "catalog:trpc",
    "@types/node": "catalog:build",
    "electron": "catalog:electron",
    "electron-builder": "catalog:electron",
    "electron-updater": "catalog:electron",
    "superjson": "catalog:trpc",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  },
  "productName": "faws",
  "description": "faws: an operations console for AWS, Kubernetes and S3-compatible storage",
  "repository": {
    "type": "git",
    "url": "https://github.com/EphraimHaber/faws.git"
  },
  "author": "Ephraim Haber"
}

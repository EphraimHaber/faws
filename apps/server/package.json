{
  "name": "@faws/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.mjs",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "import": "./src/router.ts"
    }
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsdown && node scripts/stage-native.mjs",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "node scripts/fix-native-perms.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "catalog:aws",
    "@aws-sdk/client-ec2-instance-connect": "catalog:aws",
    "@aws-sdk/client-ecs": "catalog:aws",
    "@aws-sdk/client-ssm": "catalog:aws",
    "@fastify/cors": "catalog:",
    "@fastify/static": "catalog:",
    "@faws/contracts": "workspace:*",
    "@faws/core": "workspace:*",
    "@faws/kit": "workspace:*",
    "@faws/provider-kubernetes": "workspace:*",
    "@faws/shared": "workspace:*",
    "@faws/socket-io-events": "workspace:*",
    "@trpc/server": "catalog:trpc",
    "fastify": "catalog:",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "socket.io": "catalog:",
    "ssh2": "catalog:",
    "superjson": "catalog:trpc",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:build",
    "@types/ssh2": "catalog:",
    "tsdown": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  },
  "optionalDependencies": {
    "node-pty": "catalog:"
  }
}

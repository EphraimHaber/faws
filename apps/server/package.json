{
  "name": "@faws/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.mjs",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "import": "./src/router.ts"
    }
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.3",
    "@faws/contracts": "workspace:*",
    "@faws/core": "workspace:*",
    "@faws/shared": "workspace:*",
    "@faws/socket-io-events": "workspace:*",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
